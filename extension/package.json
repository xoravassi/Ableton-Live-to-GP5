{
  "name": "ableton-live-to-gp5",
  "version": "1.5.0",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.14.1"
  },
  "type": "module",
  "scripts": {
    "build:styles": "tailwindcss -i src/ui.css -o src/ui.generated.css --minify",
    "build:dev": "npm run build:styles && tsc --noEmit && tsx build.ts",
    "test:planner": "tsx tests/export-planner.test.ts",
    "test:midi-extraction": "tsx tests/midi-extraction.test.ts",
    "test:browser-planner": "tsx tests/planner-browser.test.ts",
    "test:converter": "python ../converter/test_ableton_to_gp5.py",
    "test": "npm run test:planner && npm run test:midi-extraction && npm run test:browser-planner && npm run test:converter",
    "start": "npm run build:dev && extensions-cli run",
    "start:gp5": "npm run build:dev && extensions-cli run --storage-directory .runtime/storage --temp-directory .runtime/temp",
    "package:gp5": "npm run build:dev && extensions-cli package -i python -o dist/Ableton-Live-to-GP5.ablx"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
